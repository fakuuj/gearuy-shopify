{% schema %}
{
  "name": "GEAR UY Collection",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "GEAR UY Collection"
    }
  ]
}
{% endschema %}

<div class="gearuy-collection">
  <h2>NUEVOS INGRESOS</h2>
  <div class="gearuy-grid">
    {% for product in collections.all.products limit: 4 %}
      <a href="{{ product.url }}" class="gearuy-card">
        <div class="gearuy-img">
          <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}">
          <div class="gearuy-badge">LIMITED</div>
        </div>
        <h3>{{ product.title }}</h3>
        <p>{{ product.price | money }}</p>
      </a>
    {% else %}
      <div class="gearuy-card"><div class="gearuy-img-mock" style="background:#141414;"></div><h3>Heavyweight Hoodie - Jet Black</h3><p>$3500</p></div>
      <div class="gearuy-card"><div class="gearuy-img-mock" style="background:#0B132B;"></div><h3>LA Dodgers 59FIFTY - Fitted</h3><p>$2500</p></div>
      <div class="gearuy-card"><div class="gearuy-img-mock" style="background:#F0F0F0;"></div><h3>Classic Tee - Off White</h3><p>$1800</p></div>
      <div class="gearuy-card"><div class="gearuy-img-mock" style="background:#333333;"></div><h3>NY Yankees Trucker - Black</h3><p>$2200</p></div>
    {% endfor %}
  </div>
</div>

<style>
.gearuy-collection { padding: 60px 5%; background: #FFFFFF; }
.gearuy-collection h2 { text-transform: uppercase; font-weight: 800; font-size: 2rem; margin-bottom: 30px; color: #141414; letter-spacing:-0.5px;}
.gearuy-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.gearuy-card { text-decoration: none; color: #141414; }
.gearuy-img { position: relative; background: #F0F0F0; aspect-ratio: 4/5; overflow: hidden; }
.gearuy-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
.gearuy-card:hover .gearuy-img img { transform: scale(1.05); }
.gearuy-badge { position: absolute; top: 10px; left: 10px; background: #141414; color: #fff; font-size: 10px; font-weight: 800; padding: 5px 10px; text-transform: uppercase; letter-spacing:1px;}
.gearuy-card h3 { font-size: 14px; font-weight: 800; text-transform: uppercase; margin: 15px 0 5px 0; }
.gearuy-card p { font-size: 14px; color: #555; margin: 0; font-weight:600;}
.gearuy-img-mock { aspect-ratio: 4/5; display:flex; align-items:center; justify-content:center; color:rgba(255,255,255,0.2); font-weight:800; text-transform:uppercase; font-size:12px;}
.gearuy-img-mock::after { content: 'GEAR UY'; }
@media (max-width: 768px) {
  .gearuy-grid { grid-template-columns: repeat(2, 1fr); gap: 10px;}
  .gearuy-collection h2 { font-size: 1.5rem; text-align:center;}
}
</style>
